;;; resolve.el --- Native Elpaca resolution -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: MIT
(require 'cl-lib)
(require 'json)
(setq user-emacs-directory (file-name-as-directory (getenv "ELPACA_PURIFIER_PROJECT"))
      elpaca-directory (expand-file-name "elpaca/" (getenv "ELPACA_PURIFIER_STATE"))
      elpaca-repos-directory (expand-file-name "repos/" elpaca-directory)
      elpaca-builds-directory (expand-file-name "builds/" elpaca-directory)
      elpaca-cache-directory (expand-file-name "cache/" elpaca-directory)
      url-configuration-directory (expand-file-name "url/" (getenv "ELPACA_PURIFIER_STATE"))
      after-init-time nil)
(require 'elpaca-autoloads)
(require 'elpaca)
(defun elpaca-purifier--capture-recipe (original &rest args)
  (let* ((native (getenv "ELPACA_PURIFIER_PREPARED_LOCK"))
         (elpaca-lock-file (and (file-exists-p native) native))
         (elpaca-menu-lock-file--cache nil)
         (elpaca-menu-functions
          (if elpaca-lock-file
              (cons 'elpaca-menu-lock-file (remove 'elpaca-menu-lock-file elpaca-menu-functions))
            (remove 'elpaca-menu-lock-file elpaca-menu-functions)))
         (recipe (apply original args)))
    (unless (equal (plist-get recipe :package) "elpaca")
      (dolist (key '(:build :pre-build :post-build :vars))
        (when (plist-member recipe key)
          (error "Custom Elpaca build steps need a provider: %S" key))))
    recipe))
(advice-add 'elpaca-recipe :around #'elpaca-purifier--capture-recipe)
(when (file-exists-p (getenv "ELPACA_PURIFIER_PREPARED_LOCK"))
  (setq elpaca-lock-file (getenv "ELPACA_PURIFIER_PREPARED_LOCK"))
  (cl-pushnew 'elpaca-menu-lock-file elpaca-menu-functions))
(load (getenv "ELPACA_PURIFIER_CONFIG") nil t)
(elpaca-wait)
(elpaca-process-queues)
(let ((packages (cl-remove 'elpaca (elpaca--queued) :key #'car)) recipes)
  (dolist (item packages)
    (let ((e (cdr item)))
      (unless (eq (elpaca--status e) 'finished)
        (error "Native Elpaca resolution failed: %S %S" (car item) (elpaca<-log e)))
      (push `((name . ,(symbol-name (car item)))
              (repo . ,(elpaca<-repo-dir e))
              (repoKey . ,(file-name-nondirectory (directory-file-name (elpaca<-repo-dir e))))
              (build . ,(file-name-nondirectory (directory-file-name (elpaca<-build-dir e))))
              (recipe . ,(prin1-to-string (elpaca<-recipe e)))) recipes)))
  (if packages
      (elpaca-write-lock-file (getenv "ELPACA_PURIFIER_PREPARED_LOCK") packages)
    (let ((elpaca--queues nil))
      (elpaca-write-lock-file (getenv "ELPACA_PURIFIER_PREPARED_LOCK"))))
  (with-temp-file (getenv "ELPACA_PURIFIER_RESOLUTION")
    (insert (json-encode (vconcat (sort recipes (lambda (a b) (string< (alist-get 'name a) (alist-get 'name b)))))))))
