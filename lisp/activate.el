;;; -*- lexical-binding: t; -*-
(require 'cl-lib)
(require 'json)
(setq elpaca-directory (expand-file-name "elpaca/" (getenv "ELPACA_PURIFIER_STATE"))
      elpaca-repos-directory (expand-file-name "repos/" elpaca-directory)
      elpaca-builds-directory (expand-file-name "builds/" elpaca-directory)
      elpaca-cache-directory (expand-file-name "cache/" elpaca-directory))
(require 'elpaca-autoloads)
(require 'elpaca)
(defvar elpaca-purifier--lock
  (let ((read-eval nil)) (with-temp-buffer
    (insert-file-contents (getenv "ELPACA_PURIFIER_PREPARED_LOCK")) (read (current-buffer)))))
(defvar elpaca-purifier--expected
  (let ((json-array-type 'list) (json-object-type 'alist) (read-eval nil))
    (mapcar (lambda (item)
      (let* ((name (intern (alist-get 'name item)))
             (recipe (car (read-from-string (alist-get 'recipe item))))
             (pin (plist-get (alist-get name elpaca-purifier--lock) :recipe)))
        (unless (plist-member recipe :ref) (setq recipe (plist-put recipe :ref (plist-get pin :ref))))
        (cons name recipe))) (json-read-file (getenv "ELPACA_PURIFIER_SELECTION")))))
(defun elpaca-purifier--report (valid)
 (with-temp-file (getenv "ELPACA_PURIFIER_STATUS")
  (insert (json-encode `((valid . ,(if valid t :json-false)))))))
(defvar elpaca-purifier--invalid nil)
(defun elpaca-purifier--deny (&rest _)
 (setq elpaca-purifier--invalid t)
 (elpaca-purifier--report nil)
 (error "Elpaca packages are Nix-resolved; update the purifier lock"))
(defun elpaca-purifier--canonical (recipe)
 (let (result)
  (while recipe
   (let ((key (pop recipe)) (value (pop recipe)))
    (unless (eq key :source) (push (cons key value) result))))
  (sort result (lambda (a b) (string< (symbol-name (car a)) (symbol-name (car b)))))))
(defun elpaca-purifier--recipe (original order &rest args)
 (let* ((elpaca-menu-functions '(elpaca-menu-lock-file))
        (elpaca-lock-file (getenv "ELPACA_PURIFIER_PREPARED_LOCK"))
        (elpaca-menu-lock-file--cache elpaca-purifier--lock)
        (recipe (apply original order args))
        (id (intern (plist-get recipe :package))))
  (unless (or (eq id 'elpaca)
    (equal (elpaca-purifier--canonical recipe)
           (elpaca-purifier--canonical (alist-get id elpaca-purifier--expected))))
   (elpaca-purifier--deny))
  recipe))
(advice-add 'elpaca-recipe :around #'elpaca-purifier--recipe)
(dolist (function '(elpaca-fetch elpaca-fetch-all elpaca-merge elpaca-merge-all
 elpaca-rebuild elpaca-delete elpaca-write-lock-file elpaca--clone
 elpaca--link-build-files elpaca--checkout-ref))
 (advice-add function :override #'elpaca-purifier--deny))
(defun elpaca-purifier--complete ()
 (when elpaca-purifier--invalid (elpaca-purifier--deny))
 (let ((actual (sort (delq 'elpaca (mapcar #'car (elpaca--queued))) #'string<))
       (expected (sort (mapcar #'car elpaca-purifier--expected) #'string<)))
  (unless (equal actual expected) (elpaca-purifier--deny))
  (elpaca-purifier--report t)))
(add-hook 'elpaca-after-init-hook #'elpaca-purifier--complete)
(unless noninteractive (add-hook 'after-init-hook #'elpaca-process-queues))
